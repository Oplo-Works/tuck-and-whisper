# Cloudflare Worker 시크릿 예시 파일 — 실제 값은 절대 커밋하지 마라.
# 배포: npx wrangler secret put META_API_KEY   (또는 Cloudflare 대시보드 > Settings > Variables)

# Meta Model API 키 (필수 — Worker Secret으로만 관리한다)
META_API_KEY=PASTE_YOUR_META_API_KEY_HERE

# (선택) 업스트림 API 베이스 URL — Worker의 기본값을 쓰려면 설정하지 마라.
# META_API_BASE=https://<meta-api-endpoint>
